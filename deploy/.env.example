# Copy to `.env` and edit. docker compose auto-loads `.env` from this directory.
#
# Browser-visible URLs baked into the RService 302 (to VAgent) and the VAgent
# Stage-4b JSON (to RService). Each must be reachable from whatever device
# runs the browser. Defaults match the `ports:` mappings in docker-compose.yml.
#
# Examples:
#   browser on same laptop as docker:
#     PPIAV_VAGENT_PUBLIC_URL=http://localhost:8081
#     PPIAV_RSERVICE_PUBLIC_URL=http://localhost:8082
#
#   phone on same Wi-Fi (find host IP via `ip -4 addr`):
#     PPIAV_VAGENT_PUBLIC_URL=http://192.168.3.6:8081
#     PPIAV_RSERVICE_PUBLIC_URL=http://192.168.3.6:8082
#
#   behind a TLS reverse proxy:
#     PPIAV_VAGENT_PUBLIC_URL=https://demo.example.com/vagent
#     PPIAV_RSERVICE_PUBLIC_URL=https://demo.example.com/rservice
PPIAV_VAGENT_PUBLIC_URL=http://localhost:8081
PPIAV_RSERVICE_PUBLIC_URL=http://localhost:8082
