# Go
*.test
*.out
# Built CLI binaries (left in cmd/ subdirs by `go build`)
/cmd/*/ppiav-*
!/cmd/*/*.go
# Phase 3 service binaries built via Makefile
/bin/
# WASM build outputs
web/ppiav/*.wasm

# Node / TypeScript build artefacts. dist/ is gitignored content-only —
# the directory itself stays tracked via dist/.gitkeep so `//go:embed dist`
# in web/vclient/embed.go and web/rclient/embed.go does not fail on a
# fresh checkout before `make spas` runs.
web/ppiav/node_modules/
web/vclient/node_modules/
web/vclient/dist/*
!web/vclient/dist/.gitkeep
web/vclient/wasm_exec.js
web/rclient/node_modules/
web/rclient/dist/*
!web/rclient/dist/.gitkeep

# Python (bench/, models/)
**/.venv/
**/__pycache__/
**/*.pyc
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/

# Phase 2 prep
models/data/
models/out/

# Benchmark results — selectively committed snapshots only
results/*/
!results/.gitkeep

# Local docker compose env — `.env.example` is the committed template.
deploy/.env

# Diagram renders — regenerated from docs/*.puml via plantuml.
docs/*.png
docs/screenshots/svg/

# IDE / editor
.idea/
.vscode/
*.swp
.DS_Store
