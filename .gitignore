# Go
*.test
*.out
# Built CLI binaries (left in cmd/ subdirs by `go build`)
/cmd/*/ppiav-*
!/cmd/*/*.go
# WASM build outputs
web/ppiav/*.wasm

# Node / TypeScript build artefacts
web/ppiav/node_modules/
web/vclient/node_modules/
web/vclient/dist/
web/vclient/wasm_exec.js
web/rclient/node_modules/
web/rclient/dist/

# Python (bench/, models/)
**/.venv/
**/__pycache__/
**/*.pyc
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/

# Phase 2 prep
models/data/

# Benchmark results — selectively committed snapshots only
results/*/
!results/.gitkeep

# IDE / editor
.idea/
.vscode/
*.swp
.DS_Store
