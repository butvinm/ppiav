{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./ts",
    "baseUrl": ".",
    "paths": {
      "@ppiav/*": ["../ppiav/ts/*"]
    }
  },
  "include": ["ts/**/*.ts"]
}
